<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: a local server through `adb reverse tcp:8080 tcp:8080`. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="false">
        <!-- User CAs on purpose: a self-hosted server signed by the user's own CA
             must work, as it does in the phone's browser. -->
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
