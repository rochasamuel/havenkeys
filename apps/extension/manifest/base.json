{
  "manifest_version": 3,
  "name": "HavenKeys",
  "version": "0.5.0",
  "description": "Use logins from the HavenKeys desktop password manager.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "HavenKeys",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "64": "icons/64.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "save.html",
        "passkey.html",
        "menu.js",
        "save.js",
        "passkey.js",
        "inline.css",
        "theme.css",
        "fonts.css",
        "fonts/hanken-grotesk-latin-wght-normal.woff2",
        "fonts/source-serif-4-latin-opsz-normal.woff2",
        "fonts/jetbrains-mono-latin-500-normal.woff2"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
