{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HavenKeys",
  "version": "0.13.0",
  "identifier": "com.havenkeys.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "HavenKeys",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0f1614",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "worker-src": "'none'",
        "manifest-src": "'none'",
        "style-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "worker-src": "'none'",
        "manifest-src": "'none'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "freezePrototype": true,
      "capabilities": [
        "main"
      ],
      "pattern": {
        "use": "brownfield"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEM0FEODM5RUM4MjY3NzkKUldSNVo0THNPZGc2SGJVMnJ4UlJ2SVpQZnpyeGloMFRocnB2L1JoVzd6TzFUVmtzVjBUNUNZcGkK",
      "endpoints": [
        "https://github.com/rochasamuel/havenkeys/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-first password manager",
    "linux": {
      "deb": {
        "depends": ["libpipewire-0.3-0t64 | libpipewire-0.3-0", "libgbm1"]
      },
      "rpm": {
        "depends": ["pipewire-libs", "mesa-libgbm"]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../../LICENSE-MIT": "LICENSE-MIT",
      "../../../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}