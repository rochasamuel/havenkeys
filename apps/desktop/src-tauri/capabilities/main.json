{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only capability: the main window may call exactly these commands, listen for events, and start a window drag from its own title-bar areas (macOS overlay title bar). No plugins, no filesystem, no shell, no network.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-vault-status",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-change-master-password",
    "allow-record-activity",
    "allow-list-items",
    "allow-get-item",
    "allow-reveal-secret",
    "allow-password-history",
    "allow-device-status",
    "allow-account-status",
    "allow-activate-account",
    "allow-sign-in",
    "allow-sign-out",
    "allow-list-devices",
    "allow-revoke-device",
    "allow-remove-device",
    "allow-sync-now",
    "allow-resync-vault",
    "allow-get-emergency-kit",
    "allow-reveal-previous-password",
    "allow-get-totp-code",
    "allow-copy-secret",
    "allow-create-item",
    "allow-update-item",
    "allow-delete-item",
    "allow-generate-password",
    "allow-copy-generated-password",
    "allow-get-settings",
    "allow-update-settings",
    "allow-import-1pux",
    "allow-delete-import-file"
  ]
}
