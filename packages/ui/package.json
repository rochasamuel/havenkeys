{
  "name": "@havenkeys/ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "HavenKeys design tokens: authored in TypeScript, emitted as CSS custom properties. No runtime dependency, no framework.",
  "exports": {
    "./tokens": "./src/tokens.ts",
    "./tokens.css": "./src/tokens.css",
    "./tokens-auto.css": "./src/tokens-auto.css",
    "./base.css": "./src/base.css"
  },
  "scripts": {
    "generate": "node src/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
